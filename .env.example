OPENROUTER_API_KEY=          # https://openrouter.ai/keys
# Real PostHog (optional). Empty = the mock at http://127.0.0.1:8010 (start it with: uv run posthog-agents mock)
POSTHOG_HOST=                # e.g. https://us.posthog.com
POSTHOG_PERSONAL_API_KEY=    # phx_... with read access (and annotation write for churn-risk)
# Per-agent project ids, if your real projects differ: POSTHOG_PROJECT_CHURN_RISK=12345 ...
